# Token del bot, dal Discord Developer Portal (NON committare mai il vero valore)
DISCORD_TOKEN=

# ID del canale dove inviare il messaggio di benvenuto
WELCOME_CHANNEL_ID=

# ID del canale dove annunciare l'uscita di un membro
LEAVE_CHANNEL_ID=

# Nome del ruolo assegnato automaticamente ai nuovi membri
WELCOME_ROLE_NAME=User

# ID dei ruoli esenti dalla moderazione automatica, separati da virgola
EXEMPT_ROLE_IDS=
